{
  "name": "jim-nestjs-admin",
  "version": "6.2.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8851 --strictPort",
    "build": "vite build && node scripts/verify-production.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8852 --strictPort",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --skipLibCheck",
    "lint": "eslint \"{src,build}/**/*.{vue,js,ts,tsx}\" --max-warnings 0 && stylelint \"src/**/*.{vue,css,scss}\"",
    "test": "node --test test/*.test.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "format:check": "prettier --check \"src/**/*.{js,ts,json,tsx,css,scss,vue,html,md}\"",
    "smoke:production": "node scripts/smoke-production.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:api:check": "node scripts/gen-api.mjs --check",
    "gen:api:fixture": "node scripts/export-t03-openapi.mjs",
    "gen:crud-schema": "node scripts/gen-crud-schema.mjs",
    "gen:crud-schema:check": "node scripts/gen-crud-schema.mjs --check",
    "test:crud-contract": "node scripts/verify-t03-aggregate.mjs"
  },
  "keywords": [
    "pure-admin-thin",
    "vue-pure-admin",
    "element-plus",
    "tailwindcss",
    "pure-admin",
    "typescript",
    "pinia",
    "vue3",
    "vite",
    "esm"
  ],
  "homepage": "https://github.com/Jim-NestJS-Admin/admin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jim-NestJS-Admin/admin.git"
  },
  "bugs": {
    "url": "https://github.com/Jim-NestJS-Admin/admin/issues"
  },
  "license": "MIT",
  "author": "Jimmy",
