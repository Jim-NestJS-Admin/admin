  "paths": {
    "/admin/test/demo-log/add": {
      "post": {
        "operationId": "testDemoLogAdd",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestDemoLogAddBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "enum": [1000],
                      "type": "integer"
                    },
                    "data": {
                      "$ref": "#/components/schemas/TestDemoLogRow"
                    },
                    "message": {
                      "example": "ok",
                      "type": "string"
                    }
                  },
                  "required": ["code", "data", "message"],
                  "type": "object"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            },
            "description": "4000：参数有误、唯一冲突等，字段错误在 data.errors"
          }
        },
        "summary": "新增演示日志",
        "tags": ["test/demo-log 演示日志"]
      }
    },
